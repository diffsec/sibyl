# Sibyl console interface: one static Go binary on a distroless Wolfi base.
# Build context: the repository root.


FROM cgr.dev/chainguard/go:latest@sha256:7633fb5a27db3d39d8194be6f29c7b92fb919c3b9d0b7014c2c6999b6b14869f AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-tui ./cmd/sibyl-tui

FROM cgr.dev/chainguard/static:latest@sha256:fc42af33e643f20d08baf03cddcc1c02ba57052dfb02edb0d79f3fc47bcea8d9

COPY --from=build /out/sibyl-tui /usr/bin/sibyl-tui

USER 10001:10001
ENTRYPOINT ["/usr/bin/sibyl-tui"]
