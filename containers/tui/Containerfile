# Sibyl console interface: one static Go binary on a distroless Wolfi base.
# Build context: the repository root.


FROM cgr.dev/chainguard/go:latest@sha256:0d2e83bf723e1edef67732d22b9272dd1311c7a19dff695bd6928a7831c31a9f AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-tui ./cmd/sibyl-tui

FROM cgr.dev/chainguard/static:latest@sha256:c12f0107f8afb0bbc1b0eff96ff8675e85a10c6083d039b777c51fef5c27420f

COPY --from=build /out/sibyl-tui /usr/bin/sibyl-tui

USER 10001:10001
ENTRYPOINT ["/usr/bin/sibyl-tui"]
