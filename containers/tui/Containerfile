# Sibyl console interface: one static Go binary on a distroless Wolfi base.
# Build context: the repository root.


FROM cgr.dev/chainguard/go:latest@sha256:b42c64f7559093cf20910fc6fe750884dd55c74057a16cbeedbba42c4f9b31f8 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-tui ./cmd/sibyl-tui

FROM cgr.dev/chainguard/static:latest@sha256:54b5f14edad6f2554774d499539e837588a501bd5bf22ac6cd97b1068c35d44d

COPY --from=build /out/sibyl-tui /usr/bin/sibyl-tui

USER 10001:10001
ENTRYPOINT ["/usr/bin/sibyl-tui"]
