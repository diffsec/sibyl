# Sibyl System API: one static Go binary on a distroless Wolfi base.
# Build context: the repository root.


FROM cgr.dev/chainguard/go:latest@sha256:0d2e83bf723e1edef67732d22b9272dd1311c7a19dff695bd6928a7831c31a9f AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-api ./cmd/sibyl-api

FROM cgr.dev/chainguard/static:latest@sha256:fc42af33e643f20d08baf03cddcc1c02ba57052dfb02edb0d79f3fc47bcea8d9

COPY --from=build /out/sibyl-api /usr/bin/sibyl-api

USER 10001:10001
EXPOSE 3001
ENTRYPOINT ["/usr/bin/sibyl-api"]
