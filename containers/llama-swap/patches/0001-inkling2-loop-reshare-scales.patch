From 2a28df0f9bd55c4975b6bffb35229a6020720f13 Mon Sep 17 00:00:00 2001
From: Daniel Han <danielhanchen@gmail.com>
Date: Fri, 20 Nov 2026 15:56:20 -0800
Subject: [PATCH] model : inkling2_loop re-share the loop slots after the scale
 pass

The loop slots copy the physical layers at the end of load_arch_tensors,
before the generic pass attaches the optional .scale tensors. The slots
then miss the per-expert scales of their physical layer, so the later
passes through the core run NVFP4 experts unscaled. Copy the slots again
after the scale pass.
---
 src/llama-model.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 4c77f6f68f70..914ba9f17618 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2006,6 +2006,12 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
                 layer.nextn.shared_head_head_in_s = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_HEAD, "input_scale", i), {1}, TENSOR_NOT_REQUIRED);
             }
         }
+        // inkling2_loop: the cache slots copied the physical layers before the scale pass, re-share them
+        if (auto * lm = dynamic_cast<llama_model_inkling2_loop *>(this)) {
+            for (int il = lm->n_phys; il < n_layer_all; ++il) {
+                layers[il] = layers[lm->layer_phys(il)];
+            }
+        }
         // output scales
         if (output) {
             // weight scale
