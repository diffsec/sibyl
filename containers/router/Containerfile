# Sibyl model router: one static Go binary on a distroless Wolfi base.
# Build context: the repository root.


FROM cgr.dev/chainguard/go:latest@sha256:c983eb7e033512b641248ff9e8d1e0f79d85e676dabbafb4c0a9720e2cfbac86 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-router ./cmd/sibyl-router

FROM cgr.dev/chainguard/static:latest@sha256:fc42af33e643f20d08baf03cddcc1c02ba57052dfb02edb0d79f3fc47bcea8d9

COPY --from=build /out/sibyl-router /usr/bin/sibyl-router

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/bin/sibyl-router"]
