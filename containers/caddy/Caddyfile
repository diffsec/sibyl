# Sibyl TLS front door.
# nftables on the host redirects 443 -> 10443, 8443 -> 18443 and 9443 -> 19443,
# so this container never needs a privileged port.
# Upstream names resolve on the "sibyl" Podman network.
{
	admin off
	auto_https off
}

(tls_nd) {
	tls /tls/server.crt /tls/server.key
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Open WebUI
:10443 {
	import tls_nd
	# Open WebUI makes the first account to sign up the admin, so a fresh
	# install would give the LAN that role. Sign-up is refused here: the
	# setup wizard creates the first admin through the System API, which
	# reaches open-webui:8080 inside the sibyl network. Later accounts are
	# added by the admin (ENABLE_SIGNUP=false).
	@signup path /api/v1/auths/signup*
	respond @signup `{"detail":"Sign-up is off. Run sibyl setup on the host to create the first admin."}` 403
	reverse_proxy open-webui:8080
}

# OpenAI and Anthropic compatible API (the router), Ollama-compatible shim,
# and System API
:18443 {
	import tls_nd

	handle /health {
		respond "OK" 200
	}

	# The System API checks its own bearer token.
	handle_path /system/* {
		reverse_proxy system-api:3001
	}

	# The web console, served by the System API. It signs the owner in with
	# the password of a wheel account and keeps a session cookie.
	handle /console/* {
		reverse_proxy system-api:3001
	}

	# The model router checks the client keys itself: each client has its
	# own key and policy.
	handle /v1/* {
		reverse_proxy router:8080 {
			flush_interval -1
		}
	}

	# Ollama-compatible shim, served by the System API. It takes router
	# client keys, which it checks with the router, never the System API key.
	handle /api/* {
		reverse_proxy system-api:3001 {
			flush_interval -1
		}
	}

	handle {
		respond `{"error":"not found"}` 404
	}
}

# Arcane container manager
:19443 {
	import tls_nd
	reverse_proxy arcane:3552
}
