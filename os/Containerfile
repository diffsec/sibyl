# Sibyl host image (Fedora bootc).
# Build context: the repository root, filtered by os/Containerfile.dockerignore.
# Build:  docker buildx build -f os/Containerfile --build-arg GPU_VARIANT=amd -t sibyl-os:amd .
# The GPU userspace (ROCm, Vulkan) lives in the inference container, not here.

ARG GO_IMAGE=cgr.dev/chainguard/go@sha256:85788137110936acab58b7a2901df787f71377ffac4809a9b04db7401f689580
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44@sha256:101c835e34efb4bb94cf6731b5d79374f39b082656ccbb2370d24ea0d50b197d

# sibyl-hostd runs the privileged host actions. It runs on the host, so it is
# built here and not shipped in a container image.
FROM ${GO_IMAGE} AS hostd
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-hostd ./cmd/sibyl-hostd

FROM ${BASE_IMAGE}

ARG GPU_VARIANT=amd
ARG SIBYL_VERSION=dev
# Tag of the Sibyl service images that the Quadlet units pull.
ARG IMAGE_TAG=latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY os/packages/ /tmp/packages/
RUN grep -hEv '^\s*(#|$)' /tmp/packages/common.txt "/tmp/packages/${GPU_VARIANT}.txt" \
        | xargs dnf -y install --setopt=install_weak_deps=False \
    && dnf clean all \
    && rm -rf /tmp/packages /run/dnf /var/cache/* /var/lib/dnf /var/log/dnf*

COPY os/rootfs/ /
COPY --from=hostd /out/sibyl-hostd /usr/libexec/sibyl/hostd

# render and video live in /usr/lib/group, where systemd-sysusers cannot add
# members. Copy them to /etc/group so the "m" lines in sysusers.d apply.
RUN grep -E '^(render|video):' /usr/lib/group >> /etc/group \
    && grep -E '^(render|video):' /usr/lib/group | awk -F: '{print $1":!::"}' >> /etc/gshadow

RUN echo "${SIBYL_VERSION}" > /usr/share/sibyl/version \
    && echo "${IMAGE_TAG}" > /usr/share/sibyl/image-tag \
    && echo "${GPU_VARIANT}" > /usr/share/sibyl/gpu-variant \
    && systemctl enable nftables.service sibyl-selinux.service sibyl-firstboot.service sibyl-operator-export.service \
        sibyl-hostd.path sibyl-hostd-state.timer \
    && systemctl --global enable podman.socket sibyl-agent.path sibyl-status.timer \
    && systemctl disable bootc-fetch-apply-updates.timer \
    && sed -i "s/@IMAGE_TAG@/${IMAGE_TAG}/g" /etc/containers/systemd/users/1001/*.container \
        /etc/containers/systemd/users/1001/*.container.d/*.conf

RUN bootc container lint
