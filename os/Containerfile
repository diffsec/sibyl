# Sibyl host image (Fedora bootc).
# Build context: the repository root, filtered by os/Containerfile.dockerignore.
# Build:  docker buildx build -f os/Containerfile --build-arg GPU_VARIANT=amd -t sibyl-os:amd .
# The GPU userspace (ROCm, Vulkan) lives in the inference container, not here.


# sibyl-hostd runs the privileged host actions, sibyl-install is the disk
# installer, sibyl-update applies offline bundles, and sibyl-diag is the
# diagnostics and inference watchdog. They run on the host, so they are
# built here.
FROM cgr.dev/chainguard/go:latest@sha256:0d2e83bf723e1edef67732d22b9272dd1311c7a19dff695bd6928a7831c31a9f AS hostd
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-hostd ./cmd/sibyl-hostd \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-install ./cmd/sibyl-install \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-update ./cmd/sibyl-update \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sibyl-diag ./cmd/sibyl-diag

# The variant build scripts, as a stage: a RUN step on an SELinux build host
# cannot read a bind mount taken straight from the build context.
FROM scratch AS variants
COPY os/variants/ /

FROM quay.io/fedora/fedora-bootc:44@sha256:cbca5adc859a7c973aef49b5de1e43cc540409758f598674e3c5594099448a75

ARG GPU_VARIANT=amd
ARG SIBYL_VERSION=dev
# Tag of the Sibyl service images that the Quadlet units pull.
ARG IMAGE_TAG=latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY os/packages/ /tmp/packages/
RUN grep -hEv '^\s*(#|$)' /tmp/packages/common.txt "/tmp/packages/${GPU_VARIANT}.txt" \
        | xargs dnf -y install --setopt=install_weak_deps=False \
    && dnf clean all \
    && rm -rf /tmp/packages /run/dnf /var/cache/* /var/lib/dnf /var/log/dnf*

# Variant-specific build steps. Only nvidia has any today: it builds and
# signs the NVIDIA kernel modules (os/variants/nvidia.sh).
RUN --mount=type=bind,from=variants,target=/variants \
    --mount=type=secret,id=mok_key \
    if [ "${GPU_VARIANT}" = nvidia ]; then \
        bash /variants/nvidia.sh \
        && install -D -m 0644 /variants/sibyl-nvidia-kargs.toml /usr/lib/bootc/kargs.d/50-sibyl-nvidia.toml; \
    fi

COPY os/rootfs/ /
COPY --from=hostd /out/sibyl-hostd /usr/libexec/sibyl/hostd
COPY --from=hostd /out/sibyl-install /usr/sbin/sibyl-install
COPY --from=hostd /out/sibyl-update /usr/sbin/sibyl-update
COPY --from=hostd /out/sibyl-diag /usr/sbin/sibyl-diag

# render and video live in /usr/lib/group, where systemd-sysusers cannot add
# members. Copy them to /etc/group so the "m" lines in sysusers.d apply.
RUN grep -E '^(render|video):' /usr/lib/group >> /etc/group \
    && grep -E '^(render|video):' /usr/lib/group | awk -F: '{print $1":!::"}' >> /etc/gshadow

RUN echo "${SIBYL_VERSION}" > /usr/share/sibyl/version \
    && echo "${IMAGE_TAG}" > /usr/share/sibyl/image-tag \
    && echo "${GPU_VARIANT}" > /usr/share/sibyl/gpu-variant \
    && systemctl enable nftables.service sibyl-selinux.service sibyl-firstboot.service sibyl-operator-export.service \
        sibyl-hostd.path sibyl-hostd-auth.path sibyl-hostd-state.timer sibyl-tls.timer sibyl-provision.service \
        sibyl-diag-boot.service sibyl-diag-watchdog.service sibyl-diag-metrics.service sibyl-diag-upload.timer \
    && systemctl --global enable podman.socket sibyl-agent.path sibyl-status.timer \
    && systemctl disable bootc-fetch-apply-updates.timer \
    && mkdir -p /etc/containers/systemd/users/1001/llama-swap.container.d \
    && cp "/usr/share/sibyl/backend/${GPU_VARIANT}.conf" \
        /etc/containers/systemd/users/1001/llama-swap.container.d/backend.conf \
    && sed -i -e "s/@IMAGE_TAG@/${IMAGE_TAG}/g" -e "s/@GPU_VARIANT@/${GPU_VARIANT}/g" \
        /etc/containers/systemd/users/1001/*.container \
        /etc/containers/systemd/users/1001/*.container.d/*.conf

RUN bootc container lint
