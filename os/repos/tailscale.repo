# Tailscale's own repository. Fedora's tailscale package lags the upstream
# releases, and the security fixes in them. priority=10 picks this repository
# over Fedora's for the tailscale package. The key is in this repository, so
# the build does not trust a key that it downloads.
# Key fingerprint: 2596 A99E AAB3 3821 893C 0A79 458C A832 957F 5868
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/fedora/$basearch
enabled=1
type=rpm
priority=10
repo_gpgcheck=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-tailscale
