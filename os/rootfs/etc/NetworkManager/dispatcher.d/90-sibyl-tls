#!/bin/bash
# Reissue the Sibyl TLS certificate when an address or the hostname changes.
# The work runs in sibyl-tls.service, so the dispatcher does not wait for it.
case "${2:-}" in
    up | dhcp4-change | hostname | connectivity-change)
        systemctl start --no-block sibyl-tls.service
        ;;
esac
exit 0
