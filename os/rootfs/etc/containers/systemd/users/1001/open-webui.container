[Unit]
Description=Sibyl Open WebUI
Wants=llama-swap.service
After=llama-swap.service

[Container]
ContainerName=open-webui
# v0.12.4
Image=ghcr.io/open-webui/open-webui@sha256:a5b9e403d19154796850679c8c5d1295301cee954be8b84ddd62af92426558f7
Network=sibyl.network
Volume=open-webui.volume:/app/backend/data:Z
Secret=open-webui-secret-key,type=env,target=WEBUI_SECRET_KEY
Environment=ENABLE_OLLAMA_API=false
Environment=OPENAI_API_BASE_URL=http://llama-swap:8080/v1
Environment=OPENAI_API_KEY=none
Environment=WEBUI_NAME=Sibyl
Environment=WEBUI_AUTH=true
Environment=ENABLE_SIGNUP=false
Environment=DEFAULT_USER_ROLE=user
Environment=ENABLE_COMMUNITY_SHARING=false
Environment=ENABLE_RAG_WEB_SEARCH=false
Environment=ENABLE_IMAGE_GENERATION=false
Environment=RAG_EMBEDDING_ENGINE=openai
Environment=RAG_OPENAI_API_BASE_URL=http://llama-swap:8080/v1
Environment=RAG_OPENAI_API_KEY=none
Environment=ANONYMIZED_TELEMETRY=false
Environment=DO_NOT_TRACK=true
Environment=SCARF_NO_ANALYTICS=true
Environment=HF_HUB_OFFLINE=1
# API keys let the System API set the embedding model (Admin, Settings, Documents).
# Open WebUI stores this in its database, so it applies on the first start only.
Environment=ENABLE_API_KEYS=true
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=2048

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
