[Unit]
Description=Sibyl Caddy TLS front door

[Container]
ContainerName=caddy
Image=ghcr.io/diffsec/sibyl-caddy:@IMAGE_TAG@
Network=sibyl.network
PublishPort=10443:10443
PublishPort=18443:18443
PublishPort=19443:19443
UserNS=keep-id:uid=10001,gid=10001
Volume=/var/lib/sibyl/tls:/tls:ro,z
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/data:rw,size=16m,mode=1777
Tmpfs=/config:rw,size=16m,mode=1777
PidsLimit=512

[Service]
Restart=always

[Install]
WantedBy=default.target
