[Unit]
Description=Sibyl System API
After=sibyl-agent.path

[Container]
ContainerName=system-api
Image=ghcr.io/diffsec/sibyl-system-api:@IMAGE_TAG@
Network=sibyl.network
UserNS=keep-id:uid=10001,gid=10001
Volume=/var/lib/sibyl/models:/models:z
# Model pools. Each pool's file system is mounted with a container label, so
# no :z. rslave lets pools that are mounted or detached later show here.
Volume=/var/lib/sibyl-pools:/pools:rslave
Volume=/var/lib/sibyl/config:/config:z
Volume=/var/lib/sibyl/run:/run/sibyl:z
# Written by sibyl-hostd as root. It labels the files itself, so no :z here.
Volume=/var/lib/sibyl-host/out:/run/sibyl-host:ro
Volume=/var/lib/sibyl/home/.config/containers/systemd/llama-swap.container.d:/quadlet:z
Secret=sibyl-api-key,type=mount,target=/run/secrets/api-key,mode=0400,uid=10001,gid=10001
Environment=SIBYL_IMAGE_TAG=@IMAGE_TAG@
Environment=SIBYL_GPU_VARIANT=@GPU_VARIANT@
Environment=SIBYL_VERSION=@IMAGE_TAG@
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
PidsLimit=256

[Service]
Restart=always

[Install]
WantedBy=default.target
