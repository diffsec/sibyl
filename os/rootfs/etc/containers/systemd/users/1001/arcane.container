# Arcane container manager. Settings follow https://getarcane.app/docs/podman/setup
# for rootless Podman with systemd (Quadlet) control over D-Bus.
[Unit]
Description=Sibyl Arcane container manager
Requires=podman.socket
After=podman.socket

[Container]
ContainerName=arcane
# v2.17.1
Image=ghcr.io/getarcaneapp/manager@sha256:3d7057b7e3b3e0be4b3ba34dd1b137b02a055f97ddc232c32817666658643842
Network=sibyl.network
# Arcane docs: SELinux hosts need the label disabled for the socket and bus mounts.
SecurityLabelDisable=true
PodmanArgs=--cgroupns=host
User=0:0
UserNS=keep-id
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=%t/bus:%t/bus
Volume=arcane.volume:/app/data
Volume=/var/lib/sibyl/stacks:/var/lib/sibyl/stacks
Secret=arcane-encryption-key,type=mount,target=/run/secrets/arcane-key,mode=0400
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=PUID=1001
Environment=PGID=1001
Environment=ENCRYPTION_KEY_FILE=/run/secrets/arcane-key
Environment=PROJECTS_DIRECTORY=/var/lib/sibyl/stacks
# APP_URL, written by the first-boot script.
EnvironmentFile=/var/lib/sibyl/config/arcane.env
NoNewPrivileges=true
HealthCmd=["./arcane","health","--timeout","2s"]
HealthInterval=30s
HealthStartPeriod=15s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
