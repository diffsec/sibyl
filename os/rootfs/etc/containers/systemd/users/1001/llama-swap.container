[Unit]
Description=Sibyl llama-swap (llama.cpp inference)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=llama-swap
# The backend drop-in (llama-swap.container.d/backend.conf) sets Image=.
Network=sibyl.network
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
UserNS=keep-id:uid=10001,gid=10001
Volume=/var/lib/sibyl/models:/models:ro,z
# Model pools. Each pool's file system is mounted with a container label, so
# no :z. rslave lets pools that are mounted or detached later show here.
Volume=/var/lib/sibyl-pools:/pools:ro,rslave
# A directory mount, so llama-swap sees the API's atomic rewrites of config.yaml.
Volume=/var/lib/sibyl/config/llama-swap:/app/config:ro,z
# GPU shader caches (Mesa RADV, ROCm). :U gives the volume to the container user.
Volume=llama-swap-cache.volume:/app/.cache:U
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,size=1g,mode=1777
ShmSize=8g
Ulimit=memlock=-1:-1
PidsLimit=4096
HealthCmd=["curl","-fsS","http://127.0.0.1:8080/health"]
HealthInterval=30s
HealthStartPeriod=20s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
