#!/usr/sbin/nft -f
# Sibyl host firewall: default deny.
# Caddy runs rootless on high ports. Public ports are redirected to it:
#   443 -> 10443 (Open WebUI), 8443 -> 18443 (API), 9443 -> 19443 (Arcane)
# The high ports accept only connections that arrived through a redirect.

destroy table inet sibyl

table inet sibyl {
    set public_tcp {
        type inet_service
        elements = { 10443, 18443, 19443 }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        tcp dport 443 redirect to :10443
        tcp dport 8443 redirect to :18443
        tcp dport 9443 redirect to :19443
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state invalid drop
        ct state { established, related } accept

        # Ping and IPv6 neighbor discovery
        meta l4proto icmp icmp type echo-request limit rate 10/second accept
        meta l4proto ipv6-icmp icmpv6 type { echo-request, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept

        # DHCP replies
        udp sport 67 udp dport 68 accept
        udp sport 547 udp dport 546 accept

        # Services behind Caddy
        tcp dport @public_tcp ct status dnat accept

        # SSH, keys only (see sshd_config.d), with a new-connection rate limit
        tcp dport ssh ct state new meter ssh_rate { ip saddr limit rate 6/minute } accept
        tcp dport ssh ct state new meter ssh_rate6 { ip6 saddr limit rate 6/minute } accept

        # mDNS, so sibyl.local resolves on the LAN
        udp dport mdns accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
