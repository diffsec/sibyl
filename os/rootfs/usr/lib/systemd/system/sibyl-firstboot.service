[Unit]
Description=Sibyl secrets and TLS certificate (creates what is missing)
After=network-online.target user-runtime-dir@1001.service systemd-tmpfiles-setup.service
Wants=network-online.target
Requires=user-runtime-dir@1001.service
Before=user@1001.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/sibyl/firstboot

[Install]
WantedBy=multi-user.target
