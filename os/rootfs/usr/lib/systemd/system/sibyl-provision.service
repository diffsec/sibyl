[Unit]
Description=Create the administrator account chosen in the Sibyl installer
ConditionPathExists=/var/lib/sibyl-install/admin.json
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=sshd.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/sibyl-install provision

[Install]
WantedBy=multi-user.target
