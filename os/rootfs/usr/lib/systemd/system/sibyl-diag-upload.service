[Unit]
Description=Sibyl diagnostics upload queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Exits at once unless upload consent is "automatic".
ExecStart=/usr/sbin/sibyl-diag upload-pending
ProtectSystem=strict
ReadWritePaths=/var/lib/sibyl-diag
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
