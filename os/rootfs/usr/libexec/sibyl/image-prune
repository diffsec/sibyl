#!/bin/bash
# Remove the Sibyl images that no bootc deployment uses.
#
# Each update pulls a new tag of every Sibyl image, and Podman keeps the old
# tags. This script keeps the tags of the booted, rollback and staged
# deployments, so a rollback still has its images without a download. It
# removes every other ghcr.io/diffsec/sibyl-* tag, then the untagged images
# that no container uses. It does not touch other images, such as those of
# the stacks that Arcane runs. Podman refuses to remove an image that a
# container uses, so such an image stays.
#
# sibyl-image-prune.timer runs this 15 minutes after boot and then daily.
# With --dry-run, it lists what it would remove and changes nothing.
set -euo pipefail

DRY=
if [[ "${1:-}" == --dry-run ]]; then
    DRY=1
fi

DEPLOY=${SIBYL_PRUNE_DEPLOY:-/ostree/deploy}
REPO=ghcr.io/diffsec/sibyl-

log() { echo "sibyl-image-prune: $*"; }

# as_sibyl runs Podman as the sibyl user, as auto-update does.
as_sibyl() {
    if [[ -n "${SIBYL_PRUNE_AS_SELF:-}" ]]; then
        "$@"
        return
    fi
    setpriv --reuid=1001 --regid=1001 --init-groups -- env HOME="$(getent passwd sibyl | cut -d: -f6)" \
        XDG_RUNTIME_DIR=/run/user/1001 "$@"
}

keep=()
shopt -s nullglob
for f in "$DEPLOY"/*/deploy/*/usr/share/sibyl/image-tag; do
    t=$(<"$f")
    if [[ "$t" =~ ^[A-Za-z0-9_.-]+$ && " ${keep[*]} " != *" $t "* ]]; then
        keep+=("$t")
    fi
done
if ((${#keep[@]} == 0)); then
    log "found no deployment's image tag, so removing nothing"
    exit 0
fi
log "keeping the tags of the deployments: ${keep[*]}"

refs=$(as_sibyl podman images --format '{{.Repository}}:{{.Tag}}')
removed=0
while read -r ref; do
    [[ "$ref" == "$REPO"*:* ]] || continue
    tag=${ref##*:}
    [[ "$tag" != "<none>" ]] || continue
    for k in "${keep[@]}"; do
        # A tag of the deployment, or one of its backend variants (-hip).
        if [[ "$tag" == "$k" || "$tag" == "$k"-* ]]; then
            continue 2
        fi
    done
    if [[ -n "$DRY" ]]; then
        log "would remove $ref"
        removed=$((removed + 1))
    elif as_sibyl podman rmi "$ref" >/dev/null 2>&1; then
        log "removed $ref"
        removed=$((removed + 1))
    else
        log "kept $ref: a container uses it"
    fi
done <<<"$refs"

if [[ -n "$DRY" ]]; then
    log "would remove $removed old Sibyl image tag(s), then the untagged images"
    exit 0
fi
as_sibyl podman image prune -f >/dev/null
log "removed $removed old Sibyl image tag(s)"
