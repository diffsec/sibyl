#!/bin/bash
# Keep the TLS certificate in line with the host's names and addresses.
#
# The host has its own certificate authority (CA). Clients trust the CA once
# (/var/lib/sibyl-operator/ca.crt), and this script reissues the server
# certificate from it whenever the hostname or an IPv4 address changes, or
# the certificate expires within 30 days. The CA key stays in a root-only
# directory, and name constraints limit the CA to local names and private
# addresses, so a stolen CA key cannot vouch for a public site.
#
# Runs at boot (from firstboot), from the NetworkManager dispatcher on an
# address or hostname change, and daily (sibyl-tls.timer).
set -euo pipefail

ND_USER=sibyl
CA_DIR=/var/lib/sibyl-ca
TLS_DIR=/var/lib/sibyl/tls
ca_key="$CA_DIR/ca.key"
ca_crt="$CA_DIR/ca.crt"
key="$TLS_DIR/server.key"
crt="$TLS_DIR/server.crt"

umask 077
install -d -m 0755 -o root -g root "$CA_DIR"

# Names and addresses that the CA may vouch for. A name outside them is
# left out of the server certificate, because clients refuse a certificate
# with any name that breaks a constraint.
constraints="permitted;DNS:local,permitted;DNS:sibyl,permitted;DNS:localhost,permitted;DNS:lan"
constraints+=",permitted;DNS:home.arpa,permitted;DNS:internal"
constraints+=",permitted;IP:10.0.0.0/255.0.0.0,permitted;IP:172.16.0.0/255.240.0.0"
constraints+=",permitted;IP:192.168.0.0/255.255.0.0,permitted;IP:100.64.0.0/255.192.0.0"
constraints+=",permitted;IP:127.0.0.0/255.0.0.0"

if [[ ! -s "$ca_key" || ! -s "$ca_crt" ]]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -sha256 -days 3650 -nodes \
        -keyout "$ca_key" -out "$ca_crt" \
        -subj "/O=Sibyl/CN=Sibyl local CA $(date -u +%Y-%m-%d)" \
        -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -addext "nameConstraints=critical,$constraints" 2>/dev/null
    chmod 0600 "$ca_key"
    chmod 0644 "$ca_crt"
fi

local_name() {
    [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$ ]] || return 1
    [[ "$1" == sibyl || "$1" == localhost || "$1" =~ \.(local|lan|home\.arpa|internal)$ ]]
}

private_ip() {
    [[ "$1" =~ ^10\. || "$1" =~ ^192\.168\. || "$1" =~ ^127\. ]] && return 0
    [[ "$1" =~ ^172\.(1[6-9]|2[0-9]|3[01])\. ]] && return 0
    [[ "$1" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\. ]]
}

names=(sibyl.local sibyl localhost)
host="$(hostnamectl hostname 2>/dev/null || cat /proc/sys/kernel/hostname)"
host="${host,,}"
for n in "$host" "${host%%.*}.local"; do
    if local_name "$n"; then
        names+=("$n")
    fi
done
ips=(127.0.0.1)
while read -r ifname cidr; do
    case "$ifname" in podman*|cni*|veth*|virbr*|docker*) continue ;; esac
    ip="${cidr%/*}"
    if private_ip "$ip"; then
        ips+=("$ip")
    fi
done < <(ip -4 -o addr show scope global up | awk '{print $2, $4}')

san="$(printf 'DNS:%s\n' "${names[@]}" | sort -u; printf 'IP Address:%s\n' "${ips[@]}" | sort -u)"
want="$(printf '%s\n' "$san" | paste -sd, -)"

# Keep the certificate when it comes from this CA, holds exactly these
# names and addresses, and is valid for 30 more days.
if [[ -s "$crt" && -s "$key" ]] \
    && openssl verify -CAfile "$ca_crt" "$crt" >/dev/null 2>&1 \
    && openssl x509 -in "$crt" -noout -checkend $((30 * 86400)) >/dev/null; then
    have="$(openssl x509 -in "$crt" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | tr ',' '\n' | sort -u | paste -sd, -)"
    if [[ "$have" == "$(printf '%s\n' "$san" | tr -d ' ' | sort -u | paste -sd, -)" ]]; then
        exit 0
    fi
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
ext="$(printf '%s\n' "$san" | sed 's/^IP Address:/IP:/' | paste -sd, -)"
openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
    -keyout "$work/server.key" -out "$work/server.csr" -subj "/O=Sibyl/CN=sibyl.local" 2>/dev/null
printf 'subjectAltName=%s\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=serverAuth\n' \
    "$ext" > "$work/ext"
# 397 days: browsers refuse a server certificate valid for longer.
openssl x509 -req -in "$work/server.csr" -CA "$ca_crt" -CAkey "$ca_key" \
    -set_serial "0x$(openssl rand -hex 16)" -days 397 -sha256 -extfile "$work/ext" \
    -out "$work/leaf.crt" 2>/dev/null
# Caddy sends the whole file, so clients get the chain up to the CA.
cat "$work/leaf.crt" "$ca_crt" > "$work/server.crt"
chown "$ND_USER:$ND_USER" "$work/server.key" "$work/server.crt"
chmod 0600 "$work/server.key"
chmod 0644 "$work/server.crt"
mv -f "$work/server.key" "$key"
mv -f "$work/server.crt" "$crt"
echo "sibyl-tls: issued a certificate for $want"

# Caddy reads the certificate at start. Restart it only if it is running:
# at boot the user services have not started yet.
uid="$(id -u "$ND_USER")"
if [[ -S "/run/user/$uid/bus" ]]; then
    runuser -u "$ND_USER" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
        systemctl --user try-restart caddy.service || true
fi
