#!/bin/bash
# Copy the System API key, the inference key of the router client "default"
# and the TLS certificate where members of sibyl-operators can read them, so
# they can run the TUI without sudo and give the inference key to programs.
set -euo pipefail

dir=/var/lib/sibyl-operator
uid="$(id -u sibyl)"
secret() {
    runuser -u sibyl -- env XDG_RUNTIME_DIR="/run/user/$uid" HOME=/var/lib/sibyl/home \
        podman secret inspect --showsecret --format '{{.SecretData}}' "$1"
}

# export <secret> <file>
export_key() {
    local key
    key="$(secret "$1")"
    umask 077
    printf '%s' "$key" > "$dir/.$2.tmp"
    chown root:sibyl-operators "$dir/.$2.tmp"
    chmod 0640 "$dir/.$2.tmp"
    mv -f "$dir/.$2.tmp" "$dir/$2"
}

export_key sibyl-api-key api.key
export_key sibyl-inference-key inference.key

# The host's CA, which clients trust once. The server certificate changes
# with the addresses; the CA does not.
install -o root -g sibyl-operators -m 0644 /var/lib/sibyl-ca/ca.crt "$dir/ca.crt"
