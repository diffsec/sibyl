#!/bin/bash
# Create the TLS certificate and the Podman secrets that the Quadlet units use.
# Runs at every boot and creates only what is missing, so an upgrade that adds
# a secret gets it before the services start.
set -euo pipefail

ND_USER=sibyl
ND_UID="$(id -u "$ND_USER")"
STATE=/var/lib/sibyl
TLS_DIR="$STATE/tls"

as_nd() {
    runuser -u "$ND_USER" -- env XDG_RUNTIME_DIR="/run/user/$ND_UID" HOME="$STATE/home" "$@"
}

secret_exists() {
    as_nd podman secret exists "$1"
}

ip_addr="$(ip -4 route get 1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}')"

if [ ! -s "$TLS_DIR/server.crt" ]; then
    san="DNS:sibyl.local,DNS:sibyl"
    [ -n "$ip_addr" ] && san="$san,IP:$ip_addr"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -sha256 -days 825 -nodes \
        -keyout "$TLS_DIR/server.key" -out "$TLS_DIR/server.crt" \
        -subj "/O=Sibyl/CN=sibyl.local" \
        -addext "subjectAltName=$san"
    chown "$ND_USER:$ND_USER" "$TLS_DIR/server.key" "$TLS_DIR/server.crt"
    chmod 0600 "$TLS_DIR/server.key"
    chmod 0644 "$TLS_DIR/server.crt"
fi

if ! secret_exists sibyl-api-key; then
    printf 'sib-%s' "$(openssl rand -hex 24)" | as_nd podman secret create sibyl-api-key - >/dev/null
fi

# The router key of Open WebUI (the router client "open-webui").
if ! secret_exists sibyl-router-owui-key; then
    printf 'sib-%s' "$(openssl rand -hex 24)" | as_nd podman secret create sibyl-router-owui-key - >/dev/null
fi

if ! secret_exists arcane-encryption-key; then
    openssl rand -hex 32 | as_nd podman secret create arcane-encryption-key - >/dev/null
fi

if ! secret_exists open-webui-secret-key; then
    openssl rand -hex 32 | as_nd podman secret create open-webui-secret-key - >/dev/null
fi

if [ ! -e "$STATE/config/arcane.env" ]; then
    printf 'APP_URL=https://%s:9443\n' "${ip_addr:-sibyl.local}" > "$STATE/config/arcane.env"
    chown "$ND_USER:$ND_USER" "$STATE/config/arcane.env"
    chmod 0640 "$STATE/config/arcane.env"
fi

