#!/bin/bash
# Start the Sibyl console interface. Members of sibyl-operators can run it
# without sudo. The TUI runs in the caller's own rootless Podman and talks to
# the System API through Caddy on this host, verifying its TLS certificate.
# "sibyl setup" walks through the setup wizard.
set -euo pipefail

wizard=0
if [[ "${1:-}" == setup ]]; then
    wizard=1
fi

dir=/var/lib/sibyl-operator
if [[ ! -r "$dir/api.key" ]]; then
    echo "sibyl: $(id -un) is not in the sibyl-operators group." >&2
    echo "An administrator can add you with: sudo usermod -aG sibyl-operators $(id -un)" >&2
    echo "Then log out and back in." >&2
    exit 1
fi

cd /
# Copy the key and certificate into Podman secrets in the caller's own store.
podman secret create --replace sibyl-api-key "$dir/api.key" >/dev/null
podman secret create --replace sibyl-ca "$dir/ca.crt" >/dev/null

image="ghcr.io/ihavespoons/sibyl-tui:$(cat /usr/share/sibyl/image-tag)"
# An offline update (sibyl-update) leaves the TUI here, for hosts that cannot
# pull it. Load it once into the caller's own storage.
offline=/var/lib/sibyl-update
if ! podman image exists "$image" && [[ -r "$offline/sibyl-tui.oci.tar" ]] \
    && [[ "$(cat "$offline/sibyl-tui.ref" 2>/dev/null)" == "$image" ]]; then
    skopeo copy --quiet --preserve-digests "oci-archive:$offline/sibyl-tui.oci.tar" "containers-storage:$image"
fi

exec podman run --rm -it --network host \
    --read-only --cap-drop all --security-opt no-new-privileges \
    -e TERM="${TERM:-xterm-256color}" \
    -e SIBYL_API_URL=https://127.0.0.1:18443/system \
    -e SIBYL_TLS_SERVER_NAME=sibyl.local \
    -e SIBYL_CA_FILE=/run/secrets/sibyl-ca \
    -e SIBYL_WIZARD="$wizard" \
    --secret sibyl-api-key,type=mount,target=/run/secrets/api-key,mode=0444 \
    --secret sibyl-ca,type=mount,target=/run/secrets/sibyl-ca,mode=0444 \
    "$image"
