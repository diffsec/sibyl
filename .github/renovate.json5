// Renovate keeps every pin current: the base images in the Containerfiles,
// the third-party images in the Quadlet units, the Go modules and the
// GitHub Actions. Each pull request runs the bootc images workflow, which
// builds every image without pushing.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Actions stay pinned by commit SHA, with the release in a comment.
    "helpers:pinGitHubActionDigests",
  ],
  // The built-in quadlet manager would move the digest-only pins to the
  // newest image of any version, and it reads the @IMAGE_TAG@ placeholders
  // of Sibyl's own images as digests. The regex manager below reads the
  // Quadlet units instead.
  enabledManagers: ["dockerfile", "custom.regex", "gomod", "github-actions"],
  timezone: "Etc/UTC",
  commitMessagePrefix: "Bump",
  // Patch, minor and digest updates merge themselves once every check
  // passes. A major update waits for a maintainer.
  automerge: true,
  automergeType: "pr",
  dockerfile: {
    // Containerfile, Containerfile.hip and Containerfile.vulkan.
    managerFilePatterns: ["/(^|/)Containerfile(\\.[a-z]+)?$/"],
  },
  customManagers: [
    {
      // A third-party image in a Quadlet unit is pinned by digest, with its
      // release in the comment above it:
      //   # v0.12.4
      //   Image=ghcr.io/open-webui/open-webui@sha256:...
      // The Image= line stays digest-only, because the offline bundle
      // (scripts/bundle/make.sh, internal/bundle) reads it as one reference.
      customType: "regex",
      description: "Third-party images in the Quadlet units",
      managerFilePatterns: ["/^os/rootfs/etc/containers/systemd/users/1001/[^/]+\\.container$/"],
      matchStrings: [
        "# (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\nImage=(?<depName>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
      datasourceTemplate: "docker",
      // Release tags only: Open WebUI also publishes v0.12.4-cuda and
      // v0.12.4-ollama.
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      autoReplaceStringTemplate: "# {{{newValue}}}\nImage={{{depName}}}@{{{newDigest}}}",
    },
  ],
  packageRules: [
    {
      // The apt and apk packages in the Containerfiles have no versions,
      // and CI builds Sibyl's own images.
      matchDatasources: ["deb", "apk"],
      enabled: false,
    },
    {
      matchPackageNames: ["ghcr.io/diffsec/**"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // ROCm and the Ubuntu releases change the llama.cpp build. Move them
      // by hand after a benchmark (docs/design/overview.md).
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/rocm/dev-ubuntu-24.04", "rocm/dev-ubuntu-24.04", "docker.io/ubuntu", "ubuntu"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      // One pull request for the Chainguard images that four files share.
      matchDatasources: ["docker"],
      matchPackageNames: ["cgr.dev/chainguard/**"],
      groupName: "chainguard images",
    },
    {
      // Quay deletes old fedora-bootc manifests within days of the tag
      // moving, so a stale digest breaks the host build. Check it daily.
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/fedora/fedora-bootc"],
      schedule: ["at any time"],
    },
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "go modules",
      schedule: ["before 6am on monday"],
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "github actions",
      schedule: ["before 6am on monday"],
    },
  ],
}
